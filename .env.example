# Copy to .env and fill in. Never commit .env.

# Token from kaggle.com/settings -> API -> Create New Token.
# New-style tokens (KGAT_...) also work as KAGGLE_API_TOKEN.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Local-only credentials for the docker compose services (Bloco 1).
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_DB=olist
WAREHOUSE_USER=olist
# Used inside a connection URL: avoid @ : / in the password.
WAREHOUSE_PASSWORD=change_me

# Shared by every Airflow component; any long random string works locally.
AIRFLOW_JWT_SECRET=change_me_to_a_long_random_string
# Linux only: set to the output of `id -u` so files in airflow/logs are owned by you.
AIRFLOW_UID=50000

# Dashboard data source: postgres (the marts) or parquet (an extract from `make extract`).
DASHBOARD_SOURCE=postgres
# Local directory or base URL holding deliveries/orders/state_centroids.parquet (parquet mode).
DASHBOARD_PARQUET_LOCATION=data/extract

MLFLOW_TRACKING_URI=http://localhost:5000
