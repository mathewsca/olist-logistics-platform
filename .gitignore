# Datasets are downloaded by `make ingest` and never versioned (see docs/dados.md).
data/
*.csv
*.parquet
*.zip
# Tiny hand-written CSVs (test fixtures and dbt seeds) are the exception.
!tests/fixtures/**/*.csv
!dbt/seeds/*.csv

.env
.env.*
!.env.example
kaggle.json

mlruns/
mlartifacts/
artifacts/
models_export/
*.pkl
*.joblib
*.onnx
reports/

dbt/target*/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

airflow/logs/
airflow/plugins/__pycache__/
airflow.db

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Working notes stay on the author's machine: AI assistant context and the full ADRs (presented to
# the team; the README keeps a one-line summary of each decision).
.claude/
CLAUDE.md
AGENTS.md
docs/HANDOFF.md
docs/adr/

.vscode/
.idea/
.DS_Store
Thumbs.db
