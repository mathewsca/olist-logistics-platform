FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dependencies are installed from the metadata alone (the package __init__ holds the version), so
# editing src/ or dashboard/ only rebuilds the last layers.
COPY pyproject.toml README.md ./
COPY src/olist_platform/__init__.py src/olist_platform/
RUN pip install ".[dashboard]"

COPY src ./src
RUN pip install --no-deps .
COPY dashboard ./dashboard

RUN useradd --create-home --uid 1000 streamlit
USER streamlit

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"
CMD ["streamlit", "run", "dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
